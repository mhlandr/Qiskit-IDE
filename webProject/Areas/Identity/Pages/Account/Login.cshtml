@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div style="display:flex;justify-content:center;padding-top:2.5rem;">
    <div class="form-container animate-in" style="max-width:460px;">
        <div style="text-align:center;margin-bottom:1.5rem;">
            <div class="eyebrow" style="margin-bottom:0.5rem;">Welcome back</div>
            <h1>Sign in</h1>
            <h4>Access your quantum workspace.</h4>
        </div>
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-group">
                <label asp-for="Input.Email" class="control-label">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Password" class="control-label">Password</label>
                <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-check">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe" class="form-check-label">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
            </div>
            <button id="login-submit" type="submit" class="btn btn-primary btn-lg">Sign in</button>
        </form>
        <div style="text-align:center;margin-top:1.5rem;">
            <p style="color:var(--text-muted);font-size:0.9rem;margin:0;">
                Don't have an account?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-light">Create one</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
