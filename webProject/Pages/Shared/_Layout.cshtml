@{
    var currentPage = (ViewContext.RouteData.Values["page"] ?? "").ToString().ToLower();
    bool IsActive(params string[] paths) => paths.Any(p => currentPage.Contains(p.ToLower()));
    var bodyClass = currentPage.EndsWith("/compile") ? "is-compiler" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#05060d" />
    <title>@ViewData["Title"] — Qiskit Compiler</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/webProject.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/dist/app.css" asp-append-version="true" />
</head>
<body class="@bodyClass">
    <div class="bg-orbs" aria-hidden="true"><span></span><span></span><span></span></div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <span class="brand-text">Qiskit<span class="brand-dot">.</span>Compiler</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(currentPage.EndsWith("/index") ? "active" : "")" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPage.EndsWith("/compile") ? "active" : "")" asp-area="" asp-page="/compile">Compiler</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(IsActive("/courses/index") ? "active" : "")" asp-area="" asp-page="/Courses/Index">Courses</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsActive("/courses/enroll") ? "active" : "")" asp-area="" asp-page="/Courses/Enroll">Enroll</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsActive("/courses/mycourses") ? "active" : "")" asp-area="" asp-page="/Courses/MyCourses">My Courses</a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(IsActive("/courses/coursecreate") ? "active" : "")" asp-area="" asp-page="/Courses/CourseCreate">Create</a>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div id="root"></div>

    <div class="content-wrapper">
        <div class="container">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-inner">
                <span class="footer-brand">
                    <span class="footer-dot"></span>
                    Qiskit Compiler
                </span>
                <span class="footer-sep">•</span>
                <span>Quantum learning in your browser</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/dist/bundle.js"></script>
    <script>
        // Subtle cursor-track glow on cards
        document.addEventListener('mousemove', (e) => {
            document.querySelectorAll('.bento-tile, .course-card, .theme-card').forEach(el => {
                const r = el.getBoundingClientRect();
                const mx = ((e.clientX - r.left) / r.width) * 100;
                const my = ((e.clientY - r.top) / r.height) * 100;
                if (mx >= 0 && mx <= 100 && my >= 0 && my <= 100) {
                    el.style.setProperty('--mx', mx + '%');
                    el.style.setProperty('--my', my + '%');
                }
            });
        }, { passive: true });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
