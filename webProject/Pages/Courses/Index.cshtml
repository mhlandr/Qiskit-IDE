@page
@model webProject.Pages.Courses.IndexModel
@{
    ViewData["Title"] = "Courses";
}

<div class="page-shell">
    <div class="page-header-row animate-in">
        <div>
            <div class="eyebrow">Catalog</div>
            <h1>Explore courses</h1>
            <p>Curated quantum computing lessons — from qubits to algorithms.</p>
        </div>
        <div class="page-head-meta">
            <span class="theme-badge">@Model.Courses.Count() available</span>
        </div>
    </div>

    @if (Model.Courses.Any())
    {
        <div class="course-grid">
            @{ var accents = new[] { "#a855f7", "#6366f1", "#22d3ee", "#ec4899", "#34d399", "#fbbf24" }; var i = 0; }
            @foreach (var course in Model.Courses)
            {
                var color = accents[i++ % accents.Length];
                <div class="course-card animate-in animate-in-delay-1">
                    <div class="course-card-icon" style="border-color:@(color)40;background:linear-gradient(135deg, @(color)28, @(color)0A);">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="@color" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    </div>
                    <div class="course-card-title">@course.CourseName</div>
                    <div class="course-card-desc">@course.Description</div>
                    <div class="course-card-footer">
                        <span class="theme-badge">Course</span>
                        <a asp-page="/Courses/Enroll" class="btn-theme btn-theme-sm">
                            Enroll
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">&#128218;</div>
            <h3>No courses available yet</h3>
            <p>Check back soon — new quantum computing content is being added.</p>
        </div>
    }
</div>

<style>
    .page-shell { max-width: 1200px; margin: 0 auto; padding: 0 0.5rem; }
    .page-head-meta { display: flex; gap: 0.5rem; align-items: center; }
</style>
