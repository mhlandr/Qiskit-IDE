@page
@model webProject.Pages.Courses.IndexModel
@{
    ViewData["Title"] = "Courses";
}

<div style="max-width:1000px;margin:0 auto;">
    <div class="content-container">
        <div class="page-header">
            <h2>All Courses</h2>
            <p>Explore available quantum computing courses</p>
        </div>
        @if (Model.Courses.Any())
        {
            <div class="course-grid">
                @foreach (var course in Model.Courses)
                {
                    <div class="course-card">
                        <div class="course-card-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                        </div>
                        <div class="course-card-title">@course.CourseName</div>
                        <div class="course-card-desc">@course.Description</div>
                        <div class="course-card-footer">
                            <span class="theme-badge">Course</span>
                            <a asp-page="/Courses/Enroll" class="btn-theme btn-theme-sm">Enroll</a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">&#128218;</div>
                <h3>No courses available yet</h3>
                <p>Check back soon for new quantum computing content.</p>
            </div>
        }
    </div>
</div>
