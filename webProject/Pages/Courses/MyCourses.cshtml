@page
@model webProject.Pages.Courses.MyCoursesModel
@{
    ViewData["Title"] = "My Courses";
}

<div style="max-width:1000px;margin:0 auto;">
    <div class="content-container">
        <div class="page-header">
            <h2>My Courses</h2>
            <p>Continue learning where you left off</p>
        </div>
        @if (Model.Courses.Any())
        {
            <div class="course-grid">
                @foreach (var course in Model.Courses)
                {
                    <div class="course-card">
                        <div class="course-card-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#06b6d4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                        </div>
                        <div class="course-card-title">
                            <a asp-page="/Courses/CourseDetail" asp-route-id="@course.CourseId">@course.CourseName</a>
                        </div>
                        <div class="course-card-desc">@course.Description</div>
                        <div class="course-card-footer">
                            <span class="theme-badge theme-badge-green">Enrolled</span>
                            <a asp-page="/Courses/CourseDetail" asp-route-id="@course.CourseId" class="btn-theme btn-theme-sm">
                                Continue
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">&#128640;</div>
                <h3>You haven't enrolled in any courses yet</h3>
                <p>Browse available courses and start your quantum computing journey.</p>
                <a asp-page="/Courses/Enroll" class="btn-theme" style="margin-top:0.5rem;">Enroll Now</a>
            </div>
        }
    </div>
</div>
