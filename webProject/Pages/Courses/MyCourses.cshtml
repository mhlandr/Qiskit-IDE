@page
@model webProject.Pages.Courses.MyCoursesModel
@{
    ViewData["Title"] = "My Courses";
}

<div class="page-shell">
    <div class="page-header-row animate-in">
        <div>
            <div class="eyebrow">Your learning</div>
            <h1>My courses</h1>
            <p>Continue where you left off, or pick up something new.</p>
        </div>
        <div class="page-head-meta">
            <a asp-page="/Courses/Enroll" class="btn-theme-outline btn-theme-sm">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Enroll in more
            </a>
        </div>
    </div>

    @if (Model.Courses.Any())
    {
        <div class="course-grid">
            @foreach (var course in Model.Courses)
            {
                <div class="course-card animate-in animate-in-delay-1">
                    <div class="course-card-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22d3ee" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    </div>
                    <div class="course-card-title">
                        <a asp-page="/Courses/CourseDetail" asp-route-id="@course.CourseId">@course.CourseName</a>
                    </div>
                    <div class="course-card-desc">@course.Description</div>
                    <div class="course-card-footer">
                        <span class="theme-badge theme-badge-green">Enrolled</span>
                        <a asp-page="/Courses/CourseDetail" asp-route-id="@course.CourseId" class="btn-theme btn-theme-sm">
                            Continue
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">&#128640;</div>
            <h3>You haven't enrolled in any courses yet</h3>
            <p>Browse available courses and start your quantum computing journey.</p>
            <a asp-page="/Courses/Enroll" class="btn-theme">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Enroll Now
            </a>
        </div>
    }
</div>

<style>
    .page-shell { max-width: 1200px; margin: 0 auto; padding: 0 0.5rem; }
    .page-head-meta { display: flex; gap: 0.5rem; align-items: center; }
</style>
