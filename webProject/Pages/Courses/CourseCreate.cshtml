@page
@model webProject.Pages.Courses.CourseCreateModel
@{
    ViewData["Title"] = "Create Course";
}

<div style="display:flex;justify-content:center;padding-top:2rem;">
    <div class="form-container" style="max-width:700px;">
        <h1 style="text-align:center;">Create Course</h1>
        <h4 style="text-align:center;">Add a new quantum computing course</h4>
        <hr />
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Course.CourseName" class="control-label"></label>
                <input asp-for="Course.CourseName" class="form-control" placeholder="e.g. Introduction to Quantum Gates" />
                <span asp-validation-for="Course.CourseName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Course.Description" class="control-label"></label>
                <textarea asp-for="Course.Description" class="form-control" rows="3" placeholder="Brief course description..."></textarea>
                <span asp-validation-for="Course.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Course.Content" class="control-label"></label>
                <textarea asp-for="Course.Content" class="form-control" rows="8" placeholder="Course content (HTML supported)..." style="font-family:var(--font-mono);font-size:0.85rem;"></textarea>
                <span asp-validation-for="Course.Content" class="text-danger"></span>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                <div class="form-group">
                    <label asp-for="Course.StartDate" class="control-label"></label>
                    <input asp-for="Course.StartDate" class="form-control" />
                    <span asp-validation-for="Course.StartDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Course.EndDate" class="control-label"></label>
                    <input asp-for="Course.EndDate" class="form-control" />
                    <span asp-validation-for="Course.EndDate" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Create Course" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
