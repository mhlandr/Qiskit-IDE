@page
@model webProject.Pages.Courses.EnrollModel
@{
    ViewData["Title"] = "Enroll";
}

<div style="display:flex;justify-content:center;padding-top:1.5rem;">
    <div class="form-container animate-in" style="max-width:520px;">
        <div style="text-align:center;margin-bottom:1.5rem;">
            <div class="eyebrow" style="margin-bottom:0.5rem;">Join a course</div>
            <h1>Enroll now</h1>
            <h4>Pick a course to begin your quantum journey.</h4>
        </div>

        @if (User.Identity.IsAuthenticated)
        {
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-group">
                    <label for="CourseId" class="control-label">Select a course</label>
                    <select id="CourseId" name="CourseId" class="form-control">
                        @foreach (var course in Model.Courses)
                        {
                            <option value="@course.CourseId">@course.CourseName</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:-3px;margin-right:0.45rem;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    Enroll in course
                </button>
            </form>
        }
        else
        {
            <div class="empty-state" style="padding:1.5rem 0;">
                <div class="empty-state-icon">&#128274;</div>
                <p>You must be signed in to enroll in a course.</p>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn-theme">Sign in to continue</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
