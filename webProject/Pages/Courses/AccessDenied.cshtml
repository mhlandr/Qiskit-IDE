@page
@model webProject.Pages.Courses.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="access-denied-wrapper">
    <div class="access-denied-icon" aria-hidden="true">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
    </div>
    <div class="eyebrow" style="margin-bottom:0.75rem;">401 · Unauthorized</div>
    <h1>Access denied</h1>
    <p>You don't have permission to access this resource. If you think this is a mistake, please contact an administrator.</p>
    <div class="hero-actions">
        <a asp-page="/Index" class="btn-theme">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Back to Home
        </a>
        <a asp-area="Identity" asp-page="/Account/Login" class="btn-theme-outline">Sign in</a>
    </div>
</div>

<style>
    .access-denied-icon {
        width: 96px; height: 96px;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 1.25rem;
        color: #fb7185;
        border-radius: 24px;
        background: linear-gradient(135deg, rgba(251,113,133,0.18), rgba(251,191,36,0.1));
        border: 1px solid rgba(251,113,133,0.3);
        box-shadow: 0 0 40px rgba(251,113,133,0.15);
    }
</style>
