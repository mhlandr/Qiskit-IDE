@page
@model webProject.Pages.compileModel
@{
    ViewData["Title"] = "Compiler";
}

@section Scripts {
    <link rel="stylesheet" href="~/css/ideStyles.css">
    <script src="~/js/compiler/lib/ace.js"></script>
    <script src="~/js/compiler/lib/theme-monokai.js"></script>
    <script src="~/js/compiler/ide.js"></script>
    <script src="~/js/compilerScripts.js"></script>
}

<style>
    .content-wrapper { padding-bottom: 0 !important; padding-top: calc(var(--nav-h) + 1rem) !important; }
    .content-wrapper > .container { max-width: 1400px; padding: 0 1rem; }

    .ide-shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 0.85rem;
        height: calc(100vh - var(--nav-h) - 2.25rem);
    }
    .ide-main {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        min-width: 0;
    }

    .tab-bar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.5rem;
        background: var(--bg-elev);
        border: 1px solid var(--border);
        border-radius: var(--r-md);
        backdrop-filter: blur(10px);
    }
    .tab {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.85rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
        border-radius: var(--r-sm);
        border: 1px solid transparent;
    }
    .tab.active {
        color: var(--text);
        background: rgba(255,255,255,0.04);
        border-color: var(--border);
        box-shadow: inset 0 -2px 0 var(--accent);
    }
    .tab .lang-dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: linear-gradient(135deg, #6366f1, #ec4899);
    }
    .tab-spacer { flex: 1; }
    .tab-status {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--text-muted);
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding-right: 0.5rem;
    }
    .tab-status .dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: #34d399;
        box-shadow: 0 0 6px #34d399;
    }

    .ide-editor-panel {
        position: relative;
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 0.75rem;
        background: var(--bg-elev);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        backdrop-filter: blur(12px);
        box-shadow: var(--sh-md), var(--sh-ring);
        overflow: hidden;
        min-height: 0;
    }
    .ide-editor-panel::before {
        content: '';
        position: absolute; top: 0; left: 6%; right: 6%; height: 1px;
        background: linear-gradient(90deg, transparent, rgba(168,85,247,0.4), transparent);
    }
    .ide-editor-panel .editor {
        flex: 1;
        min-height: 280px;
        border-radius: var(--r-sm);
        overflow: hidden;
        border: 1px solid var(--border);
    }

    .run-bar {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-top: 0.7rem;
    }
    .run-bar .hint {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--text-faint);
    }
    .run-bar .hint kbd {
        background: rgba(255,255,255,0.05);
        border: 1px solid var(--border-strong);
        border-radius: 4px;
        padding: 0.1em 0.4em;
        font-size: 0.72rem;
        color: var(--text-soft);
    }
    .run-bar .spacer { flex: 1; }

    .output-panel {
        position: relative;
        padding: 0.85rem 1rem 1rem;
        background: var(--bg-elev);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        backdrop-filter: blur(12px);
        box-shadow: var(--sh-md), var(--sh-ring);
        min-height: 180px;
        max-height: 40vh;
        display: flex;
        flex-direction: column;
    }
    .output-panel::before {
        content: '';
        position: absolute; top: 0; left: 6%; right: 6%; height: 1px;
        background: linear-gradient(90deg, transparent, rgba(34,211,238,0.4), transparent);
    }
    .output-panel .output {
        flex: 1;
        height: auto;
        margin-top: 0.5rem;
        min-height: 120px;
    }

    /* Chat side */
    .ide-side {
        display: flex;
        flex-direction: column;
        min-height: 0;
    }
    .ide-side .chat-panel { height: 100%; }

    @@media (max-width: 1100px) {
        .ide-shell {
            grid-template-columns: 1fr;
            height: auto;
        }
        .ide-side { height: 60vh; }
    }
</style>

<div class="ide-shell">
    <div class="ide-main">
        <div class="tab-bar">
            <div class="tab active">
                <span class="lang-dot"></span>
                main.py
            </div>
            <div class="tab-spacer"></div>
            <div class="tab-status">
                <span class="dot"></span>
                Python · Qiskit
            </div>
        </div>

        <div class="ide-editor-panel">
            <div class="editor" id="editor"></div>
            <div class="run-bar">
                <span class="hint">Press <kbd>Ctrl</kbd> + <kbd>Enter</kbd> to run</span>
                <div class="spacer"></div>
                <button class="btn-theme-ghost" onclick="document.getElementById('output').innerHTML = '<span style=\'color:var(--text-faint);font-style:italic;\'>Output cleared.</span>'">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"></path></svg>
                    Clear
                </button>
                <button class="btn-theme" onclick="executePythonCode()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                    Run
                </button>
            </div>
        </div>

        <div class="output-panel">
            <div class="panel-header">
                <span class="dot"></span>
                Output
            </div>
            <div class="output" id="output"><span style="color:var(--text-faint);font-style:italic;">Output will appear here. Write a Qiskit circuit and press Run.</span></div>
        </div>
    </div>

    <div class="ide-side">
        <div class="chat-panel">
            <div class="chat-panel-title">
                <span class="ai-dot"></span>
                AI Assistant
            </div>
            <div class="chat-box" id="chat-box">
                <div class="chat-msg assistant-message">
                    <div class="chat-msg-label">Assistant</div>
                    Hi! I'm your quantum computing assistant. Ask me anything about Qiskit, your code, or quantum mechanics.
                </div>
            </div>
            <div class="chat-input-row">
                <input type="text" id="chat-input" placeholder="Ask a question..." onkeydown="if(event.key==='Enter')sendMessage()">
                <button class="btn-theme btn-theme-sm" onclick="sendMessage()" aria-label="Send">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
            e.preventDefault();
            if (typeof executePythonCode === 'function') executePythonCode();
        }
    });
</script>
